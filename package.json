{
  "name": "dot-qq-bridge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A single-owner QQ C2C to current-dot MCP Events bridge",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/*.test.js",
    "simulate": "node scripts/simulate.js",
    "simulate:gateway": "node scripts/simulate-gateway.js",
    "connect:qq": "node scripts/connect-qq.js",
    "status": "node --env-file-if-exists=.env scripts/status.js",
    "verify:qq": "node --env-file-if-exists=.env scripts/verify-qq-capture.js",
    "check": "node scripts/check.js"
  },
  "license": "MIT",
  "dependencies": {
    "@dot-bridge/core": "file:vendor/dot-bridge-core-0.4.0.tgz",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "silk-wasm": "3.7.1",
    "ws": "8.21.0"
  },
  "exports": {
    "./adapter": "./src/tunnel-adapter.js",
    "./config": "./src/config.js",
    "./server": "./src/server.js",
    "./runtime/live": "./scripts/qq-service.js",
    "./runtime/readiness": "./scripts/run-tunnel-readiness.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "scripts/",
    "vendor/",
    "docs/",
    "plugin/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ]
}
